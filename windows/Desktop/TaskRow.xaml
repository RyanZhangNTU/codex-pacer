<Button x:Class="CodexPacer.Windows.TaskRow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CodexPacer.Windows"
 Height="54" Padding="0" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
 FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding AccessibleName}">
 <Button.Template>
  <ControlTemplate TargetType="{x:Type local:TaskRow}">
   <Grid>
    <!-- The task's own highlight covers its row only; each Codex run under it highlights on its own, as on the Mac. -->
    <Border CornerRadius="12" Background="{TemplateBinding Background}" Opacity="{TemplateBinding HoverProgress}" IsHitTestVisible="False" VerticalAlignment="Top" Height="{Binding MainHeight}"/>
    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    <Border x:Name="Focus" CornerRadius="12" BorderThickness="1" BorderBrush="Transparent" IsHitTestVisible="False" VerticalAlignment="Top" Height="{Binding MainHeight}"/>
   </Grid>
   <ControlTemplate.Triggers>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="local:DesktopAppearance.HighContrast" Value="True"/><Condition Property="IsMouseOver" Value="True"/><Condition Property="Focusable" Value="True"/></MultiTrigger.Conditions>
     <Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
    </MultiTrigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="Focusable" Value="True"/><Condition Property="IsKeyboardFocused" Value="True"/></MultiTrigger.Conditions>
     <Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
    </MultiTrigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
 </Button.Template>
 <StackPanel VerticalAlignment="Top">
 <Border CornerRadius="12" Padding="9,8" Background="Transparent" Height="{Binding MainHeight}">
  <Grid VerticalAlignment="Center">
   <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding IconColumn}"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <local:TaskStatusIcon x:Name="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="{Binding GapRow}"/><RowDefinition Height="{Binding DetailRow}"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <!-- One line puts the subagent dots after the title, before the readings, as on the Mac. -->
    <DockPanel>
     <StackPanel x:Name="OneLineDots" DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding OneLineDotsVisible}"/>
     <TextBlock Text="{Binding Value.Title}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding TitleInk}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBlock Grid.Column="2" Text="{Binding Value.Status}" FontSize="11" FontWeight="Medium" Foreground="{Binding DetailInk}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Visibility="{Binding OneLineStatusVisible}"/>
    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" TextOptions.TextFormattingMode="Ideal" Visibility="{Binding RateLineVisible}">
     <Run Text="{Binding ShownRateText, Mode=OneWay}" FontSize="{Binding RateSize}" FontWeight="SemiBold" Foreground="{Binding RateInk}"/>
     <Run Text="{Binding ShownRateUnit, Mode=OneWay}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource Island.Tertiary}"/>
     <Run Text="{Binding ShownSeparator, Mode=OneWay}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Island.Tertiary}"/>
     <Run Text="{Binding ShownTurnTime, Mode=OneWay}" FontSize="11" FontWeight="Medium" Foreground="{Binding DurationInk}"/>
    </TextBlock>
    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding SecondLineVisible}">
     <TextBlock Text="{Binding Value.Status}" FontSize="11" FontWeight="Medium" Foreground="{Binding DetailInk}" TextTrimming="CharacterEllipsis"/>
     <StackPanel Orientation="Horizontal" Margin="10,0,0,0" Visibility="{Binding SubagentsVisible}">
      <local:IconGlyph Symbol="person.2" Ink="{DynamicResource Island.Secondary}" Width="11" Height="11" VerticalAlignment="Center"/>
      <!-- A dot per subagent; Claude cloud workers without dots keep the count. -->
      <TextBlock Text="{Binding Value.SubagentText}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Island.Secondary}" Margin="3,0,0,0" Visibility="{Binding SubagentCountVisible}"/>
      <StackPanel x:Name="TwoLineDots" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding SubagentDotsVisible}"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" Margin="10,0,0,0" Visibility="{Binding SourceVisible}">
      <local:IconGlyph Symbol="{Binding SourceSymbol}" Ink="{DynamicResource Island.Secondary}" Width="11" Height="11" Margin="0,0,3,0" VerticalAlignment="Center" Visibility="{Binding SourceIconVisible}"/>
      <TextBlock Text="{Binding Value.SourceLabel}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Island.Secondary}"/>
     </StackPanel>
     <Border Margin="8,0,0,0" Padding="6,0,6,1" CornerRadius="7" Height="14" VerticalAlignment="Center" Background="{Binding DelegatedFill}" Visibility="{Binding DelegatedVisible}">
      <TextBlock Text="{Binding Value.DelegatedText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding DelegatedInk}" VerticalAlignment="Center"/>
     </Border>
    </StackPanel>
    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="{Binding ModelOpacity}" Visibility="{Binding SecondLineVisible}">
     <StackPanel Orientation="Horizontal" Margin="0,0,7,0" Visibility="{Binding CostVisible}">
      <Ellipse Fill="{DynamicResource Island.Attention}" Width="5" Height="5" Margin="0,0,4,0" VerticalAlignment="Center" Visibility="{Binding PeakVisible}"/>
      <TextBlock Text="{Binding Value.Cost}" Foreground="{DynamicResource Island.Soft}" FontSize="11" FontWeight="Medium"/>
     </StackPanel>
     <TextBlock Text="{Binding Value.Model}" Foreground="{Binding ProviderInk}" FontSize="11" FontWeight="Medium" Visibility="{Binding ModelVisible}"/>
     <TextBlock Text="{Binding Value.Effort}" Foreground="{Binding ProviderInk}" Opacity="0.62" FontSize="11" FontWeight="Medium" Margin="4,0,0,0" Visibility="{Binding EffortVisible}"/>
    </StackPanel>
   </Grid>
  </Grid>
 </Border>
 <!-- This task's subagents, built in code, on the same rail as its Codex runs. Clicking one opens this task. -->
 <Border x:Name="SubagentRuns" Background="Transparent" Padding="22,0,6,4" Visibility="Collapsed">
  <Border Padding="12,0,0,0" BorderThickness="1.5,0,0,0" BorderBrush="{DynamicResource Island.Tertiary}">
   <StackPanel x:Name="Subagents"/>
  </Border>
 </Border>
 <!-- Codex for Claude runs of this Claude task, built in code. Clicking one opens this task. -->
 <!-- Runs fills the row's width so the pointer anywhere below the task's own row is on the runs, not the task. -->
 <Border x:Name="Runs" Background="Transparent" Padding="22,0,6,4" Visibility="Collapsed">
  <Border x:Name="DelegationRail" Padding="12,0,0,0" BorderThickness="1.5,0,0,0" BorderBrush="{DynamicResource Island.Tertiary}">
   <StackPanel x:Name="Delegations"/>
  </Border>
 </Border>
 </StackPanel>
</Button>
