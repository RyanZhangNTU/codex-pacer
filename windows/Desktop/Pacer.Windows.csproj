<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../desktop-platform.props"/>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <OutputPath>bin/$(Configuration)/net10.0-windows/</OutputPath>
    <OutputPath Condition="'$(PacerArchitecture)' == 'arm64'">bin/$(Configuration)/net10.0-windows/arm64/</OutputPath>
    <IntermediateOutputPath>obj/$(Configuration)/$(TargetFramework)/$(PacerArchitecture)/</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CodexPacer</AssemblyName>
    <RootNamespace>CodexPacer.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Pacer.ico</ApplicationIcon>
    <!-- Pacer ships English and Simplified Chinese; other framework resources only add size. -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../UpdateSupport/*.cs" Link="UpdateSupport/%(Filename)%(Extension)"/>
    <PackageReference Include="BouncyCastle.Cryptography" Version="[2.7.0]"/>
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="[2.6.4]"/>
    <PackageReference Include="Microsoft.Web.WebView2" Version="[1.0.4314.35]"/>
    <Resource Include="Assets/Fonts/*.ttf"/>
    <!-- WPF reads these from its pack resources. The SDK's default image
         content glob must not also export nonexistent loose output files. -->
    <EmbeddedResource Include="Assets/Localization/*.json"/>
    <EmbeddedResource Include="Assets/Web/*.json"/>
    <Content Include="Assets/Fonts/LICENSE.txt" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="Assets/Pacer.ico" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="../ThirdParty/WindowsAppSDK/*.txt" Link="Licenses/WindowsAppSDK/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="../ThirdParty/WebView2/*.txt" Link="Licenses/WebView2/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="../ThirdParty/BouncyCastle/LICENSE.txt" Link="Licenses/BouncyCastle/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
  <PropertyGroup>
    <PacerCompositionOutput>$(MSBuildProjectDirectory)/obj/composition/$(Configuration)/$(PacerArchitecture)</PacerCompositionOutput>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(PacerCompositionOutput)/PacerCompositionBackdrop.dll" Link="PacerCompositionBackdrop.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
  <Target Name="BuildCompositionBackdrop" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT'"
          Inputs="../Native/CompositionBackdrop/Backdrop.cpp;../Native/CompositionBackdrop/build.ps1"
          Outputs="$(PacerCompositionOutput)/PacerCompositionBackdrop.dll">
    <Exec Command="powershell -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)/../Native/CompositionBackdrop/build.ps1&quot; -Architecture $(PacerArchitecture) -OutputDirectory &quot;$(PacerCompositionOutput)&quot;"/>
  </Target>
</Project>
