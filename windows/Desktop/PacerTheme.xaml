<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CodexPacer.Windows">
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F5F5F5"/><Setter Property="FontFamily" Value="pack://application:,,,/CodexPacer;component/Assets/Fonts/#Inter"/></Style>
  <Style TargetType="Button">
   <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="9,5"/>
   <Setter Property="FontFamily" Value="pack://application:,,,/CodexPacer;component/Assets/Fonts/#Inter"/>
   <Setter Property="Foreground" Value="#EEEEF0"/><Setter Property="Background" Value="#29292E"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#41414C"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#19191F"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="local:ScrollAccessibility.Action" Value="position"/>
   <Setter Property="Width" Value="6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="True">
     <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" local:ScrollAccessibility.Action="pageUp"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb local:ScrollAccessibility.Action="position"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#555560" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" local:ScrollAccessibility.Action="pageDown"/></Track.IncreaseRepeatButton>
    </Track>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DeepSeekInfoButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Mark" Background="{TemplateBinding Background}" CornerRadius="6.5" BorderThickness="0.5">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Mark" Property="Background" Value="#14FFFFFF"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Mark" Property="BorderBrush" Value="#9E9E9E"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="QuotaActionTitle"><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DataTemplate>
  <Style x:Key="QuotaLinkButton" TargetType="Button">
   <Setter Property="Height" Value="22"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="9,0"/>
   <Setter Property="FontFamily" Value="pack://application:,,,/CodexPacer;component/Assets/Fonts/#Inter"/>
   <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="Foreground" Value="#F5F5F5"/><Setter Property="Background" Value="#0DFFFFFF"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Capsule" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Capsule" Property="Background" Value="#14FFFFFF"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Capsule" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
