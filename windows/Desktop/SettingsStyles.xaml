<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CodexPacer.Windows">
 <DataTemplate x:Key="SettingsButtonText"><TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></DataTemplate>
 <Style x:Key="SettingsProgressBar" TargetType="ProgressBar">
  <Setter Property="Height" Value="6"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="1"/>
  <Setter Property="Foreground" Value="{DynamicResource SettingsAccent}"/><Setter Property="Background" Value="{DynamicResource SettingsTile}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
   <Grid>
    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- Text, not an element: a closed ComboBox shows an element's type name instead of a copy. -->
 <DataTemplate x:Key="SettingsChoiceText"><TextBlock Text="{Binding}" MaxWidth="240" TextTrimming="CharacterEllipsis"/></DataTemplate>
 <Style TargetType="TextBlock">
  <Setter Property="FontFamily" Value="pack://application:,,,/CodexPacer;component/Assets/Fonts/#Inter"/>
  <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/>
 </Style>
 <Style TargetType="Button">
  <Setter Property="FontFamily" Value="pack://application:,,,/CodexPacer;component/Assets/Fonts/#Inter"/>
  <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/>
  <Setter Property="Background" Value="{DynamicResource SettingsButton}"/><Setter Property="Padding" Value="11,0"/><Setter Property="MinHeight" Value="24"/>
  <Setter Property="Margin" Value="0"/>
  <Setter Property="ContentTemplate" Value="{StaticResource SettingsButtonText}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsHover}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SettingsLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource SettingsLinkText}"/><Setter Property="Padding" Value="0,2"/>
 </Style>
 <!-- The default action keeps its accent while hovered, as a prominent Mac button does. -->
 <Style x:Key="SettingsProminentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource SettingsAccent}"/><Setter Property="Foreground" Value="{DynamicResource SettingsSelectionText}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.86"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsPrimary}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SettingsPathInput" TargetType="TextBox">
  <Setter Property="FontFamily" Value="pack://application:,,,/CodexPacer;component/Assets/Fonts/#Inter"/>
  <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/>
  <Setter Property="CaretBrush" Value="{DynamicResource SettingsPrimary}"/><Setter Property="Background" Value="{DynamicResource SettingsInput}"/>
  <Setter Property="Padding" Value="6,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
   <Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="{DynamicResource SettingsSeparator}">
    <Grid><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
     <TextBlock x:Name="Prompt" Text="{TemplateBinding Tag}" Foreground="{DynamicResource SettingsSecondary}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="Text" Value=""><Setter TargetName="Prompt" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SettingsDisclosure" TargetType="Expander">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
   <StackPanel>
    <ToggleButton AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Surface" Background="Transparent" Padding="14,0" MinHeight="44" BorderThickness="1" BorderBrush="Transparent" CornerRadius="12">
       <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Path x:Name="Chevron" Data="M 2,1 L 6,5 L 2,9" Stroke="{DynamicResource SettingsSecondary}" StrokeThickness="1.6" Width="8" Height="10" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" Foreground="{DynamicResource SettingsPrimary}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}" Foreground="{DynamicResource SettingsSecondary}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter x:Name="Details" Visibility="Collapsed"/>
   </StackPanel>
   <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- A folding section inside a card that already pads its content: 28 tall, no inset, as the Mac's CardDisclosure. -->
 <Style x:Key="SettingsCompactDisclosure" TargetType="Expander">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
   <StackPanel>
    <ToggleButton AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Surface" Background="Transparent" Padding="0" MinHeight="28" BorderThickness="1" BorderBrush="Transparent" CornerRadius="12">
       <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Path x:Name="Chevron" Data="M 2,1 L 6,5 L 2,9" Stroke="{DynamicResource SettingsSecondary}" StrokeThickness="1.6" Width="8" Height="10" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" Foreground="{DynamicResource SettingsPrimary}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}" Foreground="{DynamicResource SettingsSecondary}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter x:Name="Details" Visibility="Collapsed"/>
   </StackPanel>
   <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- An earlier version on one line: its number, then its highlights until opened, as on the Mac. -->
 <Style x:Key="SettingsReleaseFold" TargetType="Expander">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
   <StackPanel>
    <ToggleButton AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Surface" Background="Transparent" Padding="14,0" MinHeight="44" BorderThickness="1" BorderBrush="Transparent" CornerRadius="12">
       <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto" MinWidth="52"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Path x:Name="Chevron" Data="M 2,1 L 6,5 L 2,9" Stroke="{DynamicResource SettingsSecondary}" StrokeThickness="1.6" Width="8" Height="10" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" Foreground="{DynamicResource SettingsPrimary}" FontSize="13" FontWeight="Medium" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="Summary" Grid.Column="2" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}" Foreground="{DynamicResource SettingsSecondary}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter><Setter TargetName="Summary" Property="Visibility" Value="Hidden"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter x:Name="Details" Visibility="Collapsed"/>
   </StackPanel>
   <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- The Notifications matrix's small checkbox, as on the Mac. -->
 <Style x:Key="SettingsCheck" TargetType="CheckBox">
  <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Focusable" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <Border x:Name="Box" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent" Background="{DynamicResource SettingsButton}">
    <Path x:Name="Mark" Data="M 3.2,7.6 L 6.3,10.6 L 11.6,4.6" Stroke="{DynamicResource SettingsSelectionText}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource SettingsAccent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderThickness" Value="2"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SettingsPrimary}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.5"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- Appearance's accent swatch: a filled circle, ringed when chosen, as in System Settings. -->
 <Style x:Key="SettingsAccentSwatch" TargetType="RadioButton">
  <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Grid Background="Transparent">
    <Ellipse x:Name="Ring" Width="25" Height="25" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" Opacity="0"/>
    <Ellipse Width="18" Height="18" Fill="{TemplateBinding Background}" Stroke="#24000000" StrokeThickness="0.5"/>
    <Ellipse x:Name="Dot" Width="6" Height="6" Fill="White" Visibility="Collapsed"><Ellipse.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.35"/></Ellipse.Effect></Ellipse>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.35"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1"/><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource SettingsAccent}"/><Setter TargetName="Ring" Property="Opacity" Value="1"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- A library tile (Collapsed Bar, Expanded Panel): the body only selects. Its fill and
      stroke come from the page (washed while added); the accent rings it while selected.
      The right padding leaves room for the round button laid over its end. -->
 <Style x:Key="SettingsLibraryTile" TargetType="Button">
  <Setter Property="FontFamily" Value="pack://application:,,,/CodexPacer;component/Assets/Fonts/#Inter"/>
  <Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/><Setter Property="Background" Value="{DynamicResource SettingsTileIdle}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource SettingsTileStroke}"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,0,40,0"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsPickerHover}"/></Trigger>
    <Trigger Property="Tag" Value="selected"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="1.5"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- A library tile's round button, by its Tag: "add" is a hollow plus that takes the accent
      under the pointer; "added" is the accent with a check, a gray minus under the pointer
      or keyboard focus; "locked" stays gray because the last block cannot be removed. -->
 <Style x:Key="SettingsLibraryToggle" TargetType="Button">
  <Setter Property="Width" Value="38"/><Setter Property="Height" Value="34"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Tag" Value="add"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid Background="Transparent">
    <Grid x:Name="Mark" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0">
     <Ellipse x:Name="Focus" Margin="-3" Stroke="{DynamicResource SettingsAccent}" StrokeThickness="2" Visibility="Hidden"/>
     <Ellipse x:Name="Circle" Fill="{DynamicResource SettingsTileIdle}" Stroke="{DynamicResource SettingsTileRing}" StrokeThickness="1"/>
     <Path x:Name="Plus" Data="M12,7.5 L12,16.5 M7.5,12 L16.5,12" Stroke="{DynamicResource SettingsSecondary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
     <Path x:Name="Check" Data="M7.6,12.3 L10.6,15.2 L16.4,8.8" Stroke="{DynamicResource SettingsSelectionText}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
     <Path x:Name="Minus" Data="M7.5,12 L16.5,12" Stroke="White" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
    </Grid>
   </Grid>
   <ControlTemplate.Triggers>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="add"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
     <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource SettingsAccent}"/><Setter TargetName="Plus" Property="Stroke" Value="{DynamicResource SettingsAccent}"/>
    </MultiTrigger>
    <Trigger Property="Tag" Value="added">
     <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource SettingsAccent}"/><Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource SettingsAccent}"/>
     <Setter TargetName="Plus" Property="Visibility" Value="Collapsed"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/>
    </Trigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="added"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
     <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource SettingsTileRemove}"/><Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource SettingsTileRemove}"/>
     <Setter TargetName="Check" Property="Visibility" Value="Collapsed"/><Setter TargetName="Minus" Property="Visibility" Value="Visible"/>
    </MultiTrigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="added"/><Condition Property="IsKeyboardFocused" Value="True"/></MultiTrigger.Conditions>
     <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource SettingsTileRemove}"/><Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource SettingsTileRemove}"/>
     <Setter TargetName="Check" Property="Visibility" Value="Collapsed"/><Setter TargetName="Minus" Property="Visibility" Value="Visible"/>
    </MultiTrigger>
    <Trigger Property="Tag" Value="locked">
     <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource SettingsTileLocked}"/><Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource SettingsTileLocked}"/>
     <Setter TargetName="Plus" Property="Visibility" Value="Collapsed"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter Property="Cursor" Value="Arrow"/>
    </Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Mark" Property="Opacity" Value="0.75"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Mark" Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- A field chip (Expanded Panel's row fields): outlined while off, tinted while on. -->
 <Style x:Key="SettingsFieldChip" TargetType="CheckBox">
  <Setter Property="FontFamily" Value="pack://application:,,,/CodexPacer;component/Assets/Fonts/#Inter"/>
  <Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/>
  <Setter Property="Height" Value="28"/><Setter Property="Padding" Value="9,0,12,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <Border x:Name="Surface" CornerRadius="14" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="{DynamicResource SettingsPickerStroke}" Background="{DynamicResource SettingsTileIdle}">
    <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsPickerHover}"/></Trigger>
    <Trigger Property="IsChecked" Value="True">
     <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsChipOn}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsChipOnStroke}"/>
     <Setter Property="Foreground" Value="{DynamicResource SettingsChipOnText}"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- Help's topic capsules: the chosen one filled with the accent, as on the Mac. -->
 <Style x:Key="SettingsTopicChip" TargetType="RadioButton">
  <Setter Property="FontFamily" Value="pack://application:,,,/CodexPacer;component/Assets/Fonts/#Inter"/>
  <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/><Setter Property="Height" Value="26"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Border x:Name="Surface" CornerRadius="13" Padding="12,0" Background="{DynamicResource SettingsSearchFill}" BorderThickness="1" BorderBrush="Transparent">
    <ContentPresenter VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsAccent}"/><Setter Property="Foreground" Value="{DynamicResource SettingsSelectionText}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsPrimary}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- Help's ways in: equal cards that brighten a little under the pointer. -->
 <Style x:Key="SettingsQuickTile" TargetType="Button">
  <Setter Property="FontFamily" Value="pack://application:,,,/CodexPacer;component/Assets/Fonts/#Inter"/><Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" CornerRadius="12" Padding="14" Background="{DynamicResource SettingsCard}" BorderThickness="1" BorderBrush="{DynamicResource SettingsCardBorder}">
    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsPickerHover}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- History's rounded provider chips. -->
 <Style x:Key="SettingsChip" TargetType="RadioButton">
  <Setter Property="FontFamily" Value="pack://application:,,,/CodexPacer;component/Assets/Fonts/#Inter"/>
  <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/><Setter Property="Height" Value="24"/><Setter Property="Padding" Value="10,0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Border x:Name="Surface" Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="{DynamicResource SettingsSeparator}">
    <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsSearchFill}"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsSelectedFill}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsCardBorder}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- A whole card row that acts, such as a feedback form: a light wash under the pointer. -->
 <Style x:Key="SettingsRowButton" TargetType="Button">
  <Setter Property="FontFamily" Value="pack://application:,,,/CodexPacer;component/Assets/Fonts/#Inter"/><Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" Background="Transparent" Padding="14,0" MinHeight="44" BorderThickness="1" BorderBrush="Transparent" CornerRadius="11">
    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsFill}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SettingsSidebarButton" TargetType="Button">
  <Setter Property="Padding" Value="8,0"/><Setter Property="Height" Value="30"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SettingsSidebarChoice" TargetType="RadioButton">
  <Setter Property="Height" Value="30"/><Setter Property="Padding" Value="8,0"/>
  <Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/><Setter Property="Background" Value="Transparent"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SettingsSearchFill}"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource SettingsSidebarSelection}"/><Setter Property="Foreground" Value="{DynamicResource SettingsSidebarSelectionText}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SettingsArtChoice" TargetType="RadioButton">
  <Setter Property="Foreground" Value="{DynamicResource SettingsSecondary}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Grid>
    <Border x:Name="Outline" CornerRadius="9" Background="{DynamicResource SettingsFill}" BorderBrush="{DynamicResource SettingsTileStroke}" BorderThickness="1"/>
    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10"/>
    <Border x:Name="Focus" Margin="-3" CornerRadius="11" BorderThickness="1" BorderBrush="Transparent" IsHitTestVisible="False"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/><Setter TargetName="Outline" Property="BorderThickness" Value="2"/><Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SettingsSegmentChoice" TargetType="RadioButton">
  <Setter Property="Height" Value="24"/><Setter Property="Padding" Value="12,0"/>
  <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource SettingsSecondary}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Border x:Name="Surface" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsSelectedFill}"/><Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SettingsSwitch" TargetType="CheckBox">
  <Setter Property="Width" Value="38"/><Setter Property="Height" Value="22"/>
  <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Focusable" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <Grid>
    <Border x:Name="Focus" CornerRadius="13" BorderThickness="1" BorderBrush="Transparent" Margin="-2"/>
    <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource SettingsSwitchOff}"/>
    <Ellipse x:Name="Knob" Width="20" Height="20" HorizontalAlignment="Left" Margin="1,0" Fill="{DynamicResource SettingsKnob}">
     <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
    </Ellipse>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource SettingsSwitchOn}"/><Setter TargetName="Knob" Property="RenderTransform"><Setter.Value><TranslateTransform X="16"/></Setter.Value></Setter></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.6"/><Setter TargetName="Knob" Property="Opacity" Value="0.8"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBox">
  <Setter Property="FontFamily" Value="pack://application:,,,/CodexPacer;component/Assets/Fonts/#Inter"/>
  <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/>
  <Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="Background" Value="Transparent"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
   <Grid>
    <ToggleButton Focusable="False" AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
     <!-- The Mac's outline picker: the current choice and a chevron inside a thin rounded stroke. -->
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" Background="Transparent" BorderBrush="{DynamicResource SettingsPickerStroke}" BorderThickness="1" CornerRadius="7" Padding="9,0,7,0" MinHeight="26">
      <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" FontSize="12.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
       <Path Grid.Column="1" Width="10" Height="10" Stretch="Uniform" Stroke="{DynamicResource SettingsSecondary}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1,3 L5,7 L9,3" VerticalAlignment="Center"/>
      </Grid>
     </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsPickerFill}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsPickerHover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
     <Border Background="{DynamicResource SettingsPopup}" BorderBrush="{DynamicResource SettingsSeparator}" BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
      <ScrollViewer AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
     </Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBoxItem">
  <Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/><Setter Property="Padding" Value="8,5"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
   <!-- The current choice carries a check, as in the Mac's menu. -->
   <Border x:Name="Surface" CornerRadius="4" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Path x:Name="Check" Width="10" Height="9" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1,5 L4,8 L9,1" Visibility="Hidden" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/></Grid></Border>
   <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsAccent}"/><Setter Property="Foreground" Value="{DynamicResource SettingsSelectionText}"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TextBox">
  <Setter Property="FontFamily" Value="pack://application:,,,/CodexPacer;component/Assets/Fonts/#Inter"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/><Setter Property="CaretBrush" Value="{DynamicResource SettingsPrimary}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Surface" Background="{DynamicResource SettingsInput}" BorderBrush="{DynamicResource SettingsSeparator}" BorderThickness="1" CornerRadius="5" Padding="7,4"><ScrollViewer x:Name="PART_ContentHost"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- The sidebar search draws its own rounded fill; the field itself is bare text. -->
 <Style x:Key="SettingsSearchInput" TargetType="TextBox">
  <Setter Property="FontFamily" Value="pack://application:,,,/CodexPacer;component/Assets/Fonts/#Inter"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/><Setter Property="CaretBrush" Value="{DynamicResource SettingsPrimary}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="Transparent"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SettingsScrollBar" TargetType="ScrollBar">
  <Setter Property="local:ScrollAccessibility.Action" Value="position"/>
  <Setter Property="Width" Value="6"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
   <Track x:Name="PART_Track" IsDirectionReversed="True">
    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" local:ScrollAccessibility.Action="pageUp"/></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb local:ScrollAccessibility.Action="position"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource SettingsSecondary}" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" local:ScrollAccessibility.Action="pageDown"/></Track.IncreaseRepeatButton>
   </Track>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ScrollViewer">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
   <Grid>
    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
    <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource SettingsScrollBar}" HorizontalAlignment="Right" Margin="2" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Opacity="0"/>
   </Grid>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SettingsSecretInput" TargetType="PasswordBox">
  <Setter Property="FontFamily" Value="pack://application:,,,/CodexPacer;component/Assets/Fonts/#Inter"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/><Setter Property="CaretBrush" Value="{DynamicResource SettingsPrimary}"/>
  <Setter Property="Padding" Value="6,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
   <Border x:Name="Surface" CornerRadius="6" Background="{DynamicResource SettingsInput}" BorderBrush="{DynamicResource SettingsPickerStroke}" BorderThickness="1">
    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"/>
   </Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SettingsConnectionMenu" TargetType="ContextMenu">
  <Setter Property="FontFamily" Value="pack://application:,,,/CodexPacer;component/Assets/Fonts/#Inter"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
   <Border Background="{DynamicResource SettingsPopup}" BorderBrush="{DynamicResource SettingsSeparator}" BorderThickness="1" CornerRadius="7" Padding="4">
    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SettingsConnectionMenuItem" TargetType="MenuItem">
  <Setter Property="Foreground" Value="{DynamicResource SettingsPrimary}"/><Setter Property="Padding" Value="6,4"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
   <Border x:Name="Surface" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Path x:Name="Check" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,6 L5,9 L11,2" Width="13" Height="12" Visibility="Hidden"/>
     <ContentPresenter Grid.Column="1" ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"/>
    </Grid>
   </Border><ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsAccent}"/><Setter Property="Foreground" Value="{DynamicResource SettingsSelectionText}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
