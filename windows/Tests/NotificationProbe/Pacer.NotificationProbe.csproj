<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../desktop-platform.props"/>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Pacer.NotificationProbe</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- COM starts this exe outside the developer's DOTNET_ROOT environment. -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="[2.6.4]"/>
    <Compile Include="../../Desktop/EngineModels.cs" Link="EngineModels.cs"/>
    <Compile Include="../../Desktop/SystemNotifications.cs" Link="SystemNotifications.cs"/>
    <Compile Include="../../Desktop/WindowsSystemNotifications.cs" Link="WindowsSystemNotifications.cs"/>
    <Compile Include="../../Desktop/WindowsPlatformPolicy.cs" Link="WindowsPlatformPolicy.cs"/>
    <Compile Include="../../Desktop/NotificationActions.cs" Link="NotificationActions.cs"/>
    <Compile Include="../../Desktop/EngineClient.cs" Link="EngineClient.cs"/>
    <Compile Include="../../Desktop/EngineCrashLog.cs" Link="EngineCrashLog.cs"/>
    <Compile Include="../../Desktop/EngineTimeZone.cs" Link="EngineTimeZone.cs"/>
    <Compile Include="../../Desktop/OwnedJob.cs" Link="OwnedJob.cs"/>
    <Content Include="../../Desktop/bin/$(Configuration)/net10.0-windows/Engine/**/*" Link="Engine/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="../../Desktop/Assets/Pacer.ico" Link="Assets/Pacer.ico" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
