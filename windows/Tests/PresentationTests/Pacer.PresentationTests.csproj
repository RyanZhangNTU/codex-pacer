<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../desktop-platform.props"/>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Pacer.PresentationTests</AssemblyName>
    <ApplicationManifest>../../Desktop/app.manifest</ApplicationManifest>
    <!-- The referenced app assembly owns SDK initialization. Avoid adding a
         second copy of its internal initializer to this friend test assembly. -->
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>false</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Desktop/Pacer.Windows.csproj"/>
    <Content Include="../../Desktop/bin/$(Configuration)/net10.0-windows/Engine/**/*">
      <Link>Engine/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../Desktop/bin/$(Configuration)/net10.0-windows/CodexPacerPortable_PacerCore.resources/**/*">
      <Link>CodexPacerPortable_PacerCore.resources/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
